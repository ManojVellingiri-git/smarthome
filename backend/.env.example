# SmartHome IQ Backend Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Weather API (Optional: Leave blank to use authentic academic simulated weather stream)
OPENWEATHER_API_KEY=
OPENWEATHER_CITY=San Francisco,US

# Physical IoT Gateway Integration (Optional: For MQTT/ESP32 deployment)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_SENSORS=smarthome/sensors
